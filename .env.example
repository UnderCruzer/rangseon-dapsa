# 있으면 한 줄 프롬프트로 실제 일정을 생성 (없으면 데모 일정)
ANTHROPIC_API_KEY=
# 있으면 장소를 한국관광공사 TourAPI로 검증하고 사진·주소를 붙임 (공공데이터포털 KorService2, 인코딩/디코딩 키 모두 가능)
TOURAPI_KEY=
# 구간 이동 시간: ODsay 대중교통(lab.odsay.com, 서버 키) / 카카오모빌리티 자동차(카카오 REST API 키). 없으면 직선 추정
ODSAY_KEY=
KAKAO_REST_KEY=
# 있으면 우상단에 "실사 3D" 토글이 생김 (Google Map Tiles API 활성화 필요)
GOOGLE_MAPS_API_KEY=
# 앱 빌드용: 배포된 API 서버 주소 (웹 개발 중에는 비워 두면 Vite 프록시 사용)
VITE_API_BASE=
